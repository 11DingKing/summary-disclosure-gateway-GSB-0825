{
  "name": "summary-disclosure-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Source-gated reading-content gateway: excerpts, reader notes, editor summaries and AI summaries are distinguishable, citation-backed and policy-gated.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "prestart": "prisma migrate deploy",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.4.2",
    "@prisma/client": "^6.9.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prisma": "^6.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
